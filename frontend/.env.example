# Use the same LiveKit project as the Python agent. These are server-only values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Required in production. Enter this private passphrase when starting a session.
# Optional during local development. Use a long, random value when deploying.
ARIANA_ACCESS_CODE=

# Optional: canonical frontend origin if running behind a reverse proxy.
# APP_ORIGIN=https://ariana.example.com
