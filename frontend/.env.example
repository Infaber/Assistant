# Use the same LiveKit project as the Python agent. These are server-only values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Required in production. Enter this private passphrase when starting a session.
# Optional during local development. Use a long, random value when deploying.
ARIANA_ACCESS_CODE=

# Optional: canonical frontend origin if running behind a reverse proxy.
# APP_ORIGIN=https://ariana.example.com

# Public display name only; rebuild frontend after changing.
NEXT_PUBLIC_ASSISTANT_NAME=Ariana

# Optional local inference. Server-only: use the same values in both env files.
# The default model alias is created by scripts/setup_local_model.py.
# ARIANA_OLLAMA_URL=http://127.0.0.1:11434
# ARIANA_LOCAL_MODEL=ariana-local:8b
# ARIANA_LOCAL_VOICE_PATH=/absolute/path/to/local-voice
