LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=

# Optional voice-model selection. Leave the backup empty to use explicit reconnect.
ARIANA_GOOGLE_MODEL=gemini-3.8-live
ARIANA_FALLBACK_GOOGLE_MODEL=
# Warm female voice; American English delivery is set in the agent instructions.
ARIANA_GOOGLE_VOICE=Sulafat

# Local smart-home integration
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Optional local wake detector: install desktop/install.sh --wake-word first.
# Free local detector; no account or access key. Default phrase: Ariana.
# Optional override of the model directory (normally in Application Support).
ARIANA_WAKE_WORD_MODEL_DIR=

# Optional agent health port (native companion uses 8083).
ARIANA_AGENT_PORT=

# Optional read-only camera awareness; off by default. Private environment only.
ARIANA_CAMERA_ENABLED=false
# Optional scored recognition-event names; no face images or identity authorization.
ARIANA_CAMERA_RECOGNITION_ENABLED=false
FRIGATE_URL=http://frigate.local:8971
FRIGATE_CAMERA=bedroom
# Use a read-only viewer account. Bearer token OR username/password (not both).
FRIGATE_TOKEN=
FRIGATE_USERNAME=
FRIGATE_PASSWORD=
# Event subscriptions require operator setup AND separate spoken session approval.
ARIANA_CAMERA_EVENTS_ENABLED=false
# Friendly unnamed arrival greetings instead of technical person-entry notices.
# Needs explicit camera-announcement approval, saved locally until disabled.
ARIANA_CAMERA_GREETING_ENABLED=false
# Optional fresh-name lookup for arrivals (metadata only, no images).
ARIANA_CAMERA_NAMED_GREETING_ENABLED=false
FRIGATE_HA_PERSON_ENTITY=
FRIGATE_HA_CAMERA_ENTITY=
FRIGATE_HA_ALERT_ENTITY=
