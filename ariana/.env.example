LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=

# Optional voice-model selection. Leave the backup empty to use explicit reconnect.
ARIANA_GOOGLE_MODEL=gemini-3.8-live
ARIANA_FALLBACK_GOOGLE_MODEL=

# Local smart-home integration
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Optional local wake detector: install desktop/install.sh --wake-word first.
# Keep the key and custom macOS model outside Git.
PORCUPINE_ACCESS_KEY=
ARIANA_WAKE_WORD_MODEL=

# Optional agent health port (native companion uses 8083).
ARIANA_AGENT_PORT=

# Optional read-only camera awareness; off by default. Private environment only.
ARIANA_CAMERA_ENABLED=false
FRIGATE_URL=http://frigate.local:8971
FRIGATE_CAMERA=bedroom
# Use a read-only viewer account. Bearer token OR username/password (not both).
FRIGATE_TOKEN=
FRIGATE_USERNAME=
FRIGATE_PASSWORD=
# Event subscriptions require operator setup AND separate spoken session approval.
ARIANA_CAMERA_EVENTS_ENABLED=false
FRIGATE_HA_PERSON_ENTITY=
FRIGATE_HA_CAMERA_ENTITY=
FRIGATE_HA_ALERT_ENTITY=
