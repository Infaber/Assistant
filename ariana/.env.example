LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=

# Optional browser settings. Set headless=1 on servers; 0 opens a local window.
ARIANA_BROWSER_HEADLESS=0
ARIANA_BROWSER_TIMEOUT_MS=15000
ARIANA_BROWSER_MAX_TEXT_LENGTH=8000
# Comma-separated hosts; includes subdomains. Leave empty for public web access.
# Include duckduckgo.com if browser_search should work with an allowlist.
ARIANA_BROWSER_ALLOWED_HOSTS=
ARIANA_SEARCH_TIMEOUT_SECONDS=15
